# ============================================================
# Sano — configuração de hospedagem (Discloud)
#
# A Discloud sobe UM processo Node. Por isso o build gera os dois
# artefatos: a API compilada (backend/dist) e o site (frontend/dist),
# e o Express serve os dois na mesma origem — é o que mantém os
# cookies SameSite=strict funcionando.
# ============================================================

NAME=Sano
TYPE=site
ID=sano.discloud.app

# Entry point: o build do TypeScript gera backend/dist/server.js
MAIN=backend/dist/server.js

# 1500 MB. O runtime do Node + Prisma fica bem folgado nesse valor;
# o pico de memória acontece no BUILD, não aqui.
RAM=1500

VERSION=latest

# Compila o backend (tsc) e o frontend (vite). Precisa ser a partir da
# RAIZ do repositório — o projeto é um workspace npm.
BUILD=npm run build:host

# Aplica as migrations, garante que exista um admin e sobe o servidor.
# Tudo em JavaScript puro porque em produção só as `dependencies` estão
# instaladas — não há `tsx` para rodar scripts .ts.
# `migrate deploy` só aplica o que falta, e o ensure-admin é idempotente:
# rodar em todo boot é seguro.
START=npx prisma migrate deploy --schema backend/prisma/schema.prisma && node backend/prisma/ensure-admin.js && node backend/dist/server.js