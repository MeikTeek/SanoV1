generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  passwordHash       String
  role               Role      @default(USER)
  twoFactorSecret    String? // criptografado (AES-256-GCM)
  twoFactorEnabled   Boolean   @default(false)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int       @default(0) // incrementar = invalida todas as sessões
  lastLoginAt        DateTime?
  /// Nome de exibição — trocável pelo usuário (limite de 1x a cada 2 meses).
  displayName        String?
  /// Última troca de displayName; base do bloqueio de 2 meses.
  nameChangedAt      DateTime?
  /// Avatar em data URL (data:image/...;base64) para não exigir storage externo.
  avatarDataUrl      String?
  /// Bio curta exibida no perfil individual dentro de uma conversa.
  bio                String?   @db.VarChar(280)
  /// Chave pública ECDH P-256 (SPKI em base64) usada no E2EE do bate-papo.
  chatPublicKey      String?
  /// "Número" do usuário no bate-papo: muda a cada `chatNumberWindowHours`.
  chatNumber         String?   @unique
  /// Instante em que o `chatNumber` atual expira e será recalculado.
  chatNumberUntil    DateTime?
  showOnlineStatus   Boolean   @default(true)
  showActivityStatus Boolean   @default(true)
  lastSeenAt         DateTime?
  currentActivity    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs       AuditLog[]
  toolsData       ToolData[]
  appointments    Appointment[]
  training        TrainingProfile?
  stats           PlayerStats?
  missions        DailyMission[]
  workoutLogs     WorkoutLog[]
  workoutSessions WorkoutSession[]
  dietPlans       DietPlan[]

  /**
   * Módulo 1 — Bate-papo criptografado
   */
  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  chatMembers            ChatMember[]
  chatMessages           ChatMessage[]
  musicSharesCreated     MusicShare[]    @relation("MusicShareOwner")
  musicTracks            MusicTrack[]

  /**
   * Finanças — orçamento por envelopes (inspirado no Actual)
   */
  financeSettings       FinanceSettings?
  financeAccounts       FinanceAccount[]
  financeCategoryGroups FinanceCategoryGroup[]
  financeCategories     FinanceCategory[]
  financePayees         FinancePayee[]
  financeTransactions   FinanceTransaction[]
  financeBudgets        FinanceBudget[]
  financeSchedules      FinanceSchedule[]
}

model MusicTrack {
  id           String   @id @default(uuid())
  ownerId      String
  title        String
  artist       String
  album        String
  genre        String
  mood         String
  coverDataUrl String?  @db.Text
  favorite     Boolean  @default(false)
  duration     Float    @default(0)
  fileName     String
  mimeType     String
  size         Int
  objectKey    String   @unique
  status       String   @default("PENDING") // PENDING | READY
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, createdAt])
}

model MusicShare {
  id        String    @id @default(uuid())
  ownerId   String
  codeHash  String    @unique
  objectKey String    @unique
  status    String    @default("PENDING") // PENDING | READY | CLAIMED
  expiresAt DateTime
  createdAt DateTime  @default(now())
  claimedAt DateTime?

  owner User @relation("MusicShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([expiresAt, status])
}

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String
  recipientId String
  pairKey     String              @unique
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester User @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
}

/// Conversa individual ou grupo. `dmKey` (par de ids ordenado) garante que
/// exista no máximo uma conversa direta entre duas pessoas.
model ChatConversation {
  id            String   @id @default(uuid())
  kind          String   @default("DM") // DM | GROUP
  name          String? // apenas grupos
  /// Chave "idA:idB" (ordenada) — única para conversas diretas.
  dmKey         String?  @unique
  createdById   String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  members  ChatMember[]
  messages ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  role           String   @default("MEMBER") // OWNER | MEMBER
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

/// Mensagem criptografada. `envelope` é um blob opaco: chave pública efêmera do
/// remetente + uma cópia do texto cifrado por destinatário. O servidor nunca
/// tem a chave que abre isso. `meta` guarda apenas dados não sensíveis
/// (tipo de mídia, tamanho, duração) para a UI renderizar antes de decifrar.
model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  /// Gerado pelo cliente; evita mensagem duplicada em retentativa/reconexão.
  clientId       String?
  kind           String   @default("TEXT") // TEXT | IMAGE | AUDIO
  envelope       Json
  meta           Json?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ToolData {
  id        String   @id @default(uuid())
  userId    String
  tool      String // ex: "agenda", "games", "trainer"
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tool, key])
  @@index([userId, tool])
}

/// Compromisso da agenda. lembretes ficam no mesmo registro: `remindBefore` é
/// quantos minutos antes avisar e `reminderSentAt` garante aviso único.
model Appointment {
  id             String    @id @default(uuid())
  userId         String
  title          String
  description    String?
  participants   String? // "João e Maria"
  startsAt       DateTime
  endsAt         DateTime?
  remindBefore   Int? // em minutos; null = sem lembrete
  reminderSentAt DateTime? // preenchido quando o aviso foi disparado
  status         String    @default("PENDING") // PENDING | DONE | CANCELED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([userId, status, startsAt])
  @@index([reminderSentAt])
}

/**
 * ===================== Módulo 5 — Trainer (Fase 4) =====================
 */

/// Perfil do jogador: a "ficha" criada no onboarding. Tudo que o motor de
/// regras precisa para decidir o que é seguro prescrever.
model TrainingProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  weightKg         Float
  heightCm         Float
  birthYear        Int
  sex              String // M | F | OTHER
  goal             String // HYPERTROPHY | WEIGHT_LOSS | CONDITIONING | HEALTH
  equipment        String[] // ["academia", "peso-corporal", "elastico", "barra-fixa", "halteres"]
  injuries         String[] // ["joelho", "lombar", "ombro"] — filtra exercícios proibidos
  minutesPerDay    Int      @default(45)
  restrictionNotes String?

  // ── Adaptatividade: o que faz o plano variar de pessoa para pessoa ──
  somatotype       String? // ECTOMORPH | MESOMORPH | ENDOMORPH
  experience       String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  trainingDays     Int      @default(3)
  trainingWeekdays Int[]    @default([1, 3, 5]) // 0=domingo .. 6=sábado
  trainingLocation String   @default("GYM") // GYM | CALISTHENICS
  targetWeightKg   Float?
  pregnancy        Boolean?
  heartCondition   Boolean?
  medicationUse    Boolean?
  parqAnswers      Json?
  sleepHours       Float    @default(7)
  waterLiters      Float    @default(2)
  mealsPerDay      Int      @default(3)
  dietQuality      String   @default("FAIR") // POOR | FAIR | GOOD
  dietNotes        String?
  dietRestrictions String[]

  onboardedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments BodyAssessment[]
}

/// Registro corporal periódico e respostas de recuperação para acompanhar tendências.
model BodyAssessment {
  id                 String   @id @default(uuid())
  userId             String
  day                String // Data local YYYY-MM-DD; um questionário por dia
  weightKg           Float
  bodyFatPercent     Float?
  waistCm            Float?
  neckCm             Float?
  hipCm              Float?
  chestCm            Float?
  armCm              Float?
  thighCm            Float?
  calfCm             Float?
  wristCm            Float?
  restingHeartRate   Int?
  sleepHours         Float?
  fatigue            Int? // escala subjetiva de 0 a 10
  muscleSoreness     Int? // escala subjetiva de 0 a 10
  nutritionAdherence Int? // escala subjetiva de 1 a 5
  notes              String?  @db.VarChar(500)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profile TrainingProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, createdAt])
}

/// Plano alimentar calculado pelo código. A IA escreve os "~pratos", nunca as calorias.
model DietPlan {
  id        String   @id @default(uuid())
  userId    String
  day       String
  kcal      Int
  proteinG  Int
  carbG     Int
  fatG      Int
  /// Texto em linguagem natural produzido pela IA (ou local, sem chave configurada).
  meals     String?
  /// Resumo numérico dos ajustes aplicados pelo motor (objetivo, sono, hidratação).
  rationale Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

/// Atributos RPG + progressão. Um registro por usuário (upsert).
model PlayerStats {
  userId          String    @id
  strength        Float     @default(10) // parte superior / resistência muscular
  agility         Float     @default(10) // cardio, flexibilidade
  stamina         Float     @default(10) // HIIT, constância
  vitality        Float     @default(10) // sono, hidratação, dieta
  xp              Int       @default(0)
  level           Int       @default(1)
  streak          Int       @default(0)
  /// Dia da última conclusão — base para calcular ofensiva e penalidade.
  lastCompletedOn DateTime?
  /// Atributos debuffados até esta data (Penalty Zone).
  debuffUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Missão diária gerada pelo motor determinístico.
model DailyMission {
  id             String    @id @default(uuid())
  userId         String
  /// Dia local (YYYY-MM-DD) ao qual a missão pertence — unicidade por usuário/dia.
  day            String
  title          String
  /// Blocos da missão: exercício, alvo e série, gravados como JSON.
  blocks         Json
  /// Volume planejado em minutos, já ajustado ao tempo disponível do perfil.
  plannedMinutes Int       @default(0)
  completedAt    DateTime?
  xpAwarded      Int       @default(0)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  progress MissionProgress[]

  @@unique([userId, day])
  @@index([userId, createdAt])
}

/// Progresso de cada bloco dentro da missão do dia.
model MissionProgress {
  id        String   @id @default(uuid())
  missionId String
  /// Chave do bloco dentro do JSON (ex.: "flexoes").
  blockKey  String
  /// Quantas vezes o usuário marcou o bloco como concluído.
  doneCount Int      @default(0)
  updatedAt DateTime @updatedAt

  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, blockKey])
}

/// Registro bruto de treino — insumo do relatório semanal da IA.
model WorkoutLog {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String?
  day         String
  exercise    String
  exerciseKey String?
  muscleGroup String?
  sets        Int      @default(0)
  reps        Int      @default(0)
  loadKg      Float?
  minutes     Int      @default(0)
  createdAt   DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  setDetails WorkoutSet[]

  @@index([userId, day])
  @@index([sessionId])
}

/// Uma sessão concluída, inspirada na separação rotina → treino do wger.
/// Os registros antigos continuam válidos porque sessionId é opcional.
model WorkoutSession {
  id          String    @id @default(uuid())
  userId      String
  day         String
  title       String
  status      String    @default("COMPLETED") // STARTED | COMPLETED | CANCELED
  notes       String?   @db.VarChar(500)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs WorkoutLog[]

  @@index([userId, day])
  @@index([userId, createdAt])
}

/// Série individual executada, preservando carga, repetições e RIR reais.
model WorkoutSet {
  id           String   @id @default(uuid())
  workoutLogId String
  setNumber    Int
  reps         Int
  loadKg       Float?
  rir          Int?
  completedAt  DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@unique([workoutLogId, setNumber])
}

/**
 * ===================== Finanças — orçamento por envelopes =====================
 */
/**
 * Modelo inspirado no Actual Budget: todo dinheiro que entra numa categoria de
 * receita vai para "A orçar"; o usuário distribui esse valor entre as
 * categorias de despesa (envelopes). Valores são SEMPRE inteiros em centavos —
 * nada de ponto flutuante em dinheiro. Datas são texto `AAAA-MM-DD`
 * (dia civil, sem fuso), o que também as torna ordenáveis.
 */

/// Marca que o módulo foi inicializado para o usuário (categorias padrão ou
/// migração do ledger antigo em ToolData). A chave primária é o próprio
/// userId: duas abas abrindo o módulo ao mesmo tempo não duplicam a carga.
model FinanceSettings {
  userId        String   @id
  currency      String   @default("BRL")
  initializedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(100)
  type      String   @default("CHECKING") // CHECKING | SAVINGS | CREDIT | CASH | INVESTMENT | OTHER
  /// Fora do orçamento: investimentos, bens. O saldo conta no patrimônio,
  /// mas as transações não têm categoria nem afetam os envelopes.
  offBudget Boolean  @default(false)
  closed    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  schedules    FinanceSchedule[]

  @@index([userId, sortOrder])
}

model FinanceCategoryGroup {
  id        String  @id @default(uuid())
  userId    String
  name      String  @db.VarChar(100)
  isIncome  Boolean @default(false)
  hidden    Boolean @default(false)
  sortOrder Int     @default(0)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories FinanceCategory[]

  @@index([userId, sortOrder])
}

model FinanceCategory {
  id        String  @id @default(uuid())
  userId    String
  groupId   String
  name      String  @db.VarChar(100)
  hidden    Boolean @default(false)
  sortOrder Int     @default(0)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        FinanceCategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  budgets      FinanceBudget[]
  payees       FinancePayee[]

  @@index([userId])
  @@index([groupId, sortOrder])
}

/// Beneficiário ("Mercado X", "Salário"). Guarda a última categoria usada
/// para sugerir automaticamente na próxima transação.
model FinancePayee {
  id             String  @id @default(uuid())
  userId         String
  name           String  @db.VarChar(200)
  lastCategoryId String?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastCategory FinanceCategory?     @relation(fields: [lastCategoryId], references: [id], onDelete: SetNull)
  transactions FinanceTransaction[]

  @@unique([userId, name])
}

model FinanceTransaction {
  id         String   @id @default(uuid())
  userId     String
  accountId  String
  date       String   @db.VarChar(10) // AAAA-MM-DD
  amount     Int // centavos; negativo = saída
  payeeId    String?
  categoryId String?
  notes      String?  @db.VarChar(500)
  cleared    Boolean  @default(false)
  /// Transferência: id da transação espelho na outra conta.
  transferId String?  @unique
  /// Impressão digital da linha importada (CSV), para não importar duas vezes.
  importHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payee    FinancePayee?    @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([userId, importHash])
}

/// Valor orçado de uma categoria num mês. `carryover` = saldo negativo também
/// passa para o mês seguinte (em vez de sair do "A orçar"), como no Actual.
model FinanceBudget {
  id         String  @id @default(uuid())
  userId     String
  categoryId String
  month      String  @db.VarChar(7) // AAAA-MM
  budgeted   Int     @default(0) // centavos
  carryover  Boolean @default(false)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([userId, month])
}

/// Conta recorrente (aluguel, salário, assinatura). Como os "schedules" do
/// Actual: `nextDate` é o próximo vencimento; lançar cria a transação e avança.
model FinanceSchedule {
  id                String   @id @default(uuid())
  userId            String
  name              String   @db.VarChar(100)
  accountId         String
  payee             String?  @db.VarChar(200)
  categoryId        String?
  transferAccountId String?
  amount            Int // centavos; negativo = saída
  frequency         String   @default("MONTHLY") // WEEKLY | MONTHLY | YEARLY | ONCE
  interval          Int      @default(1)
  nextDate          String   @db.VarChar(10)
  /// Dia original do vencimento: um "todo dia 31" volta a 31 depois de fevereiro.
  anchorDay         Int      @default(1)
  /// Lança sozinho quando vence (ao abrir o módulo); senão só avisa.
  autoPost          Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, active, nextDate])
}
