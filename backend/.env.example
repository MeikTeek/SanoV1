NODE_ENV=development
PORT=8080
DATABASE_URL="postgresql://USER:SENHA@HOST:5432/sano?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# URL do frontend (origem permitida / CORS / checagem CSRF)
# Use o host pelo qual o site é acessado. Se o mesmo deploy atender mais de um
# host, liste os extras em FRONTEND_URLS, separados por vírgula.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS=http://localhost:5173,https://exemplo.discloud.dev
# strict (mesmo domínio) | lax | none (domínios diferentes, exige HTTPS)
COOKIE_SAMESITE=strict
APP_NAME=Sano

# Usados apenas pelo seed (primeiro admin)
ADMIN_USERNAME=admin
# Sempre entre aspas: sem elas o "#" vira comentario no dotenv e trunca a senha.
ADMIN_PASSWORD="TroqueEssaSenha#2026"

# IA do módulo de treino (Fase 4). Gateway compatível com a API da OpenAI.
# Sem AI_API_KEY o módulo funciona só com o motor determinístico (100% seguro).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# Storage S3-compatible para pacotes temporários de compartilhamento musical.
# Para Cloudflare R2, use o endpoint https://<account-id>.r2.cloudflarestorage.com.
# Para MinIO, use por exemplo http://localhost:9000 e mantenha force-path-style.
MUSIC_STORAGE_ENDPOINT=
MUSIC_STORAGE_REGION=auto
MUSIC_STORAGE_BUCKET=
MUSIC_STORAGE_ACCESS_KEY=
MUSIC_STORAGE_SECRET_KEY=

# Integração Discord (SanoBot): mesmo valor de SANO_BOT_SECRET no .env do bot.
# Gere com: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
DISCORD_BOT_SECRET=
